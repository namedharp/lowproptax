{
  "name": "lowproptax-appeal-intelligence",
  "version": "0.3.0",
  "description": "Evidence-grounded property tax appeal research for LowPropTax analysts.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --import tsx --test tests/rendered-html.test.mjs tests/ingestion.test.ts tests/llm-config.test.ts tests/redaction.test.ts tests/qdrant.test.ts tests/runtime-mode.test.ts tests/security-migration.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "ingest:foia": "tsx scripts/ingest-foia.ts",
    "ingest:preview": "tsx scripts/ingest-foia.ts --dry-run",
    "sync:drive": "tsx scripts/sync-google-drive.ts",
    "sync:sacramento": "node --conditions=react-server --import tsx scripts/sync-sacramento.ts",
    "evaluate:pilot": "tsx scripts/evaluate-pilot.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@cloudflare/workers-types": "5.20260728.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "google-auth-library": "10.9.1",
    "pdfjs-dist": "6.2.108",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "type": "module"
}
