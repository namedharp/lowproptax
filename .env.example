# The app runs with safe fictional data until DEMO_MODE is set to false.
DEMO_MODE=true

# Analyst access is deny-by-default when DEMO_MODE=false.
ANALYST_EMAIL_ALLOWLIST=analyst@example.com

# DeepInfra is the configured answer provider. Keep its API key server-only.
# The app posts to /chat/completions using the OpenAI-compatible request format.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=deepinfra
LLM_API_KEY=
LLM_API_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_API_STYLE=chat-completions
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_SERVICE_TIER=default
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600

# Embeddings are separate because a chat-only key may not provide embeddings.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Existing Qdrant collections use 1,536-dimensional vectors.
QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_RESEARCH_COLLECTION=lpt_research
QDRANT_APPEAL_COLLECTION=appeal_comps

# Use a publishable key in the browser. Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# FOIA ingestion runs server-side or from the private worker/CLI.
FOIA_SOURCE_DIR=
FOIA_DEFAULT_COUNTY=
FOIA_DEFAULT_DOCUMENT_TYPE=other
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_API_KEY=
