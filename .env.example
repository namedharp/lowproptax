# The app runs with safe fictional data until DEMO_MODE is set to false.
DEMO_MODE=true

# Analyst access is deny-by-default when DEMO_MODE=false.
ANALYST_EMAIL_ALLOWLIST=analyst@example.com
LPT_ADMIN_EMAILS=admin@example.com
# Start with admins, then change to analysts after the live smoke test.
LPT_LIVE_ACCESS_PHASE=admins

# DeepInfra is the configured answer provider. Keep its API key server-only.
# The app posts to /chat/completions using the OpenAI-compatible request format.
OPENAI_API_KEY=
LLM_PROVIDER=deepinfra
LLM_API_KEY=
LLM_API_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_API_STYLE=chat-completions
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_SERVICE_TIER=default
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600

# Qdrant Cloud Inference creates both dense MiniLM and sparse BM25 vectors.
# Keep secrets on the server/worker. Never expose them with NEXT_PUBLIC_.
QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_DENSE_MODEL=sentence-transformers/all-minilm-l6-v2
QDRANT_BM25_MODEL=qdrant/bm25
QDRANT_RESEARCH_COLLECTION=lpt_research_live
QDRANT_APPEAL_COLLECTION=appeal_comps_live
QDRANT_PRIVATE_COLLECTION=case_private_live

# Use a publishable key in the browser. Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# FOIA ingestion runs server-side or from the private worker/CLI.
FOIA_SOURCE_DIR=
FOIA_DEFAULT_COUNTY=Sacramento
FOIA_DEFAULT_DOCUMENT_TYPE=other
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_DRIVE_API_KEY=

# Sacramento source synchronization.
SACRAMENTO_LAMBDA_URL=https://hti7263ie3vj7m2pihbcz5cg5m0limca.lambda-url.us-east-1.on.aws/
SACRAMENTO_SYNC_MAX_PAGES=20

# Millage must expose a read-only HTTPS API. The current HTTP web login is not
# accepted by the application.
MILLAGE_API_URL=https://millage.example.com
MILLAGE_API_KEY=
MILLAGE_PROPERTY_PATH_TEMPLATE=/v1/properties/{id}
